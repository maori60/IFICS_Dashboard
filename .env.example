# IFICS Platform V1 - environment template
# Copy to .env and replace every CHANGE_ME value before first startup.
# Never commit .env, passwords, encryption keys, job tokens or SMTP credentials.

COMPOSE_PROJECT_NAME=ifics

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=ifics_app
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=ifics
DATABASE_URL=postgresql://ifics_app:CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD@db:5432/ifics?schema=public

# Only required when generating development migrations. It is not used by
# `prisma migrate deploy` in production and must never target the production DB.
SHADOW_DATABASE_URL=postgresql://ifics_app:CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD@db:5432/ifics_shadow?schema=public

# -----------------------------------------------------------------------------
# Application / authentication
# -----------------------------------------------------------------------------
# Production: use the final HTTPS public origin, without a trailing slash.
APP_BASE_URL=https://ifics.example.org
APP_PORT=3000
SESSION_COOKIE_NAME=ifics_session
SESSION_TTL_HOURS=12
MFA_ISSUER=IFICS

# The application is designed to sit behind a trusted reverse proxy on the same
# host. Set to false if requests reach Node directly.
TRUST_PROXY=true

# 32 random bytes, base64 encoded:
#   openssl rand -base64 32
APP_ENCRYPTION_KEY=CHANGE_ME_WITH_32_RANDOM_BYTES_BASE64

# Independent random value used to pseudonymise IP addresses in logs/audit:
#   openssl rand -hex 32
IP_HASH_PEPPER=CHANGE_ME_WITH_A_RANDOM_PEPPER

# Long random bearer token for internal scheduled jobs (document expiry, etc.):
#   openssl rand -hex 32
INTERNAL_JOB_TOKEN=CHANGE_ME_WITH_A_RANDOM_JOB_TOKEN

# Bootstrap administrator. Recommended procedure: do not persist these values in
# .env after bootstrap; pass them only to the one-off seed command documented in
# docs/operations/production-debian.md.
ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD=CHANGE_ME_WITH_A_UNIQUE_PASSWORD_AT_LEAST_16_CHARS
ADMIN_FIRST_NAME=Administrateur
ADMIN_LAST_NAME=IFICS

# -----------------------------------------------------------------------------
# Documents
# -----------------------------------------------------------------------------
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=10

# -----------------------------------------------------------------------------
# Optional SMTP (invitations, password reset, security notifications)
# Leave SMTP_HOST empty only for a local/test installation. Production should use
# a transactional SMTP provider rather than hosting a mail server on the machine.
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=IFICS <no-reply@example.invalid>

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info
