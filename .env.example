# IFICS Dashboard - environment template
# Copy to .env and replace every CHANGE_ME value before first startup.
# Never commit .env, passwords, encryption keys or SMTP credentials.

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=ifics_app
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=ifics
DATABASE_URL=postgresql://ifics_app:CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD@db:5432/ifics?schema=public

# Used only by `prisma migrate dev` / migration generation. Never point this to
# the same database as DATABASE_URL because Prisma is allowed to reset it.
SHADOW_DATABASE_URL=postgresql://ifics_app:CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD@db:5432/ifics_shadow?schema=public

# -----------------------------------------------------------------------------
# Application / authentication
# -----------------------------------------------------------------------------
APP_BASE_URL=http://localhost:3000
APP_PORT=3000
POSTGRES_PORT=5432
SESSION_COOKIE_NAME=ifics_session
SESSION_TTL_HOURS=12
MFA_ISSUER=IFICS Dashboard

# 32 random bytes, base64 encoded. Example generation command:
#   openssl rand -base64 32
APP_ENCRYPTION_KEY=CHANGE_ME_WITH_32_RANDOM_BYTES_BASE64

# Independent random value used to pseudonymise IP addresses in logs/audit.
#   openssl rand -hex 32
IP_HASH_PEPPER=CHANGE_ME_WITH_A_RANDOM_PEPPER

# Bootstrap administrator. The seed refuses weak/default credentials.
ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD=CHANGE_ME_WITH_A_UNIQUE_PASSWORD_AT_LEAST_16_CHARS
ADMIN_FIRST_NAME=Administrateur
ADMIN_LAST_NAME=IFICS

# -----------------------------------------------------------------------------
# Documents
# -----------------------------------------------------------------------------
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=10

# -----------------------------------------------------------------------------
# Optional SMTP (password reset / operational notifications)
# Leave SMTP_HOST empty to disable outbound mail. The application remains usable;
# administrators can still manage users from the settings screen.
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=IFICS Dashboard <no-reply@example.invalid>

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
