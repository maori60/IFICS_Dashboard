# IFICS Dashboard - local/development environment template
#
# Copy this file to .env before starting the stack:
#   cp .env.example .env
#
# Never commit .env or real secrets.

# PostgreSQL container
POSTGRES_USER=ifics_app
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=ifics

# Application database connection string.
# Keep this value consistent with the PostgreSQL variables above.
# If the password contains reserved URI characters, URL-encode them here.
DATABASE_URL=postgresql://ifics_app:CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD@db:5432/ifics?schema=public

# Host port used to expose Nuxt during local development/testing.
APP_PORT=3000
