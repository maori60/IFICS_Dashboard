enum CraStatus {
  DRAFT
  SUBMITTED
  REVIEWED
  CLIENT_PENDING
  VALIDATED
  REFUSED
}

enum CraDayType {
  WORK
  PAID_LEAVE
  RTT
  SICK_LEAVE
  AUTHORIZED_ABSENCE
  UNJUSTIFIED_ABSENCE
  TRAINING
  PUBLIC_HOLIDAY
  OTHER
}

enum CraDocumentType {
  IFICS_TO_SIGN
  INTERVENOR_SIGNED
  CLIENT_ATTESTED
}

enum CraDocumentStatus {
  GENERATED
  SENT_TO_INTERVENOR
  RECEIVED
  APPROVED
  REJECTED
  SUPERSEDED
}

enum CraAntivirusStatus {
  PENDING
  CLEAN
  INFECTED
  ERROR
  NOT_APPLICABLE
}

enum CraClientAccessPurpose {
  INITIAL_CONFIRMATION
  REDOWNLOAD
}

enum CraClientAccessStatus {
  PENDING
  ACTIVE
  COMPLETED
  EXPIRED
  REVOKED
}

enum CraClientDecisionType {
  ACCEPTED
  REFUSED
}

model CraReport {
  id            String    @id @default(cuid())
  associationId String
  projectId     String
  intervenorId  String
  year          Int
  month         Int
  status        CraStatus @default(DRAFT)
  revision      Int       @default(1)

  submittedAt DateTime?
  validatedAt DateTime?

  reviewedAt   DateTime?
  reviewedById String?

  correctionRequestedAt   DateTime?
  correctionRequestedById String?
  correctionReason        String?   @db.VarChar(2000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignment      ProjectIntervenor   @relation(fields: [projectId, intervenorId], references: [projectId, intervenorId], onDelete: Restrict)
  days            CraDay[]
  documents       CraDocument[]
  clientDecisions CraClientDecision[]

  @@unique([projectId, intervenorId, year, month])
  @@unique([id, intervenorId])
  @@index([associationId, year, month, status])
  @@index([intervenorId, year, month])
}

model CraDay {
  id              String     @id @default(cuid())
  reportId        String
  intervenorId    String
  date            DateTime   @db.Date
  dayType         CraDayType @default(WORK)
  durationMinutes Int        @default(420)
  comment         String?    @db.VarChar(2000)
  hasIncident     Boolean    @default(false)
  incident        String?    @db.VarChar(5000)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  report CraReport @relation(fields: [reportId, intervenorId], references: [id, intervenorId], onDelete: Restrict)

  @@unique([intervenorId, date])
  @@index([reportId, date])
  @@index([reportId, dayType])
}

model CraDocument {
  id             String            @id @default(cuid())
  reportId       String
  type           CraDocumentType
  status         CraDocumentStatus
  version        Int               @default(1)
  reportRevision Int

  ificsVisaDate           DateTime? @db.Date
  intervenorSignatureDate DateTime? @db.Date

  reference    String  @unique @db.VarChar(80)
  originalName String  @db.VarChar(255)
  storedName   String  @db.VarChar(255)
  filePath     String  @db.VarChar(500)
  mimeType     String  @db.VarChar(100)
  fileSize     BigInt
  sha256       String? @db.VarChar(64)

  generatedByUserId String?
  uploadedByUserId  String?
  reviewedByUserId  String?

  sourceDocumentId String?
  sourceDocument   CraDocument?  @relation("CraDocumentSource", fields: [sourceDocumentId], references: [id], onDelete: Restrict)
  derivedDocuments CraDocument[] @relation("CraDocumentSource")

  sentToIntervenorAt DateTime?
  receivedAt         DateTime?
  reviewedAt         DateTime?
  rejectionReason    String?   @db.VarChar(2000)

  antivirusStatus    CraAntivirusStatus @default(PENDING)
  antivirusCheckedAt DateTime?
  antivirusResult    String?            @db.VarChar(255)

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  report                    CraReport           @relation(fields: [reportId], references: [id], onDelete: Restrict)
  clientAccesses            CraClientAccess[]
  clientDecisionSources     CraClientDecision[] @relation("CraClientDecisionSource")
  clientDecisionAttestation CraClientDecision?  @relation("CraClientDecisionAttested")

  @@unique([reportId, type, version])
  @@unique([id, reportId])
  @@index([reportId, status])
  @@index([reportId, type])
  @@index([status])
  @@index([antivirusStatus])
  @@index([sha256])
  @@index([sourceDocumentId])
  @@index([archivedAt])
}

model CraClientAccess {
  id         String                 @id @default(cuid())
  reportId   String
  documentId String
  purpose    CraClientAccessPurpose
  status     CraClientAccessStatus  @default(ACTIVE)

  tokenHash      String @unique @db.VarChar(64)
  recipientEmail String @db.VarChar(320)

  createdByUserId String?

  expiresAt     DateTime
  firstViewedAt DateTime?
  downloadedAt  DateTime?
  confirmedAt   DateTime?
  completedAt   DateTime?
  revokedAt     DateTime?

  emailSentAt    DateTime?
  emailMessageId String?   @db.VarChar(255)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  document CraDocument        @relation(fields: [documentId, reportId], references: [id, reportId], onDelete: Restrict)
  decision CraClientDecision?

  @@unique([id, reportId])
  @@index([reportId, status])
  @@index([documentId])
  @@index([recipientEmail])
  @@index([expiresAt])
  @@index([purpose, status])
}

model CraClientDecision {
  id       String @id @default(cuid())
  accessId String
  reportId String

  decision CraClientDecisionType

  firstName String  @db.VarChar(120)
  lastName  String  @db.VarChar(120)
  jobTitle  String  @db.VarChar(180)
  comment   String? @db.VarChar(2000)

  recipientEmail   String @db.VarChar(320)
  organizationName String @db.VarChar(255)

  decidedAt DateTime @default(now())
  createdAt DateTime @default(now())

  sourceDocumentId        String
  sourceDocumentReference String @db.VarChar(80)
  sourceDocumentSha256    String @db.VarChar(64)

  attestedDocumentId String

  access CraClientAccess @relation(fields: [accessId, reportId], references: [id, reportId], onDelete: Restrict)
  report CraReport       @relation(fields: [reportId], references: [id], onDelete: Restrict)

  sourceDocument CraDocument @relation("CraClientDecisionSource", fields: [sourceDocumentId, reportId], references: [id, reportId], onDelete: Restrict)

  attestedDocument CraDocument @relation("CraClientDecisionAttested", fields: [attestedDocumentId, reportId], references: [id, reportId], onDelete: Restrict)

  @@unique([accessId, reportId])
  @@unique([attestedDocumentId, reportId])
  @@index([reportId, decidedAt])
  @@index([sourceDocumentId])
  @@index([recipientEmail])
  @@index([decision])
}
