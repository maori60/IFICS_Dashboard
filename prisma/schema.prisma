generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ClientType {
  MAIRIE
  SERVICE_MUNICIPAL
  ETABLISSEMENT_SCOLAIRE
  ASSOCIATION
  AUTRE
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

enum ProjectStatus {
  DRAFT
  VALIDATED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum IntervenorStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AssignmentStatus {
  PENDING
  ACCEPTED
  REFUSED
  CANCELLED
}

enum ProjectDocumentType {
  CONTRACT
  CONVENTION
  QUOTE
  INVOICE
  REPORT
  ANNEX
  OTHER
}

enum DocumentVisibility {
  ADMIN_ONLY
  INTERNAL
  CLIENT_VISIBLE
  INTERVENOR_VISIBLE
}

enum AccountingDocumentType {
  QUOTE
  INVOICE
}

enum AccountingDocumentStatus {
  PENDING
  ACCEPTED
  REFUSED
}

enum ReportStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  VALIDATED
  REFUSED
}

enum IntervenorDocumentType {
  IDENTITY
  SIRENE
  RC_PRO
  CONTRACT
  CONVENTION
  SIGNED_CONVENTION
  OTHER
}

enum IntervenorDocumentStatus {
  PENDING
  ACCEPTED
  REFUSED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ACTION
  SECURITY
}

enum BillingDocumentKind {
  QUOTE
  INVOICE
}

enum BillingDocumentStatus {
  DRAFT
  ISSUED
  SENT
  ACCEPTED
  REJECTED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum AuditOutcome {
  SUCCESS
  FAILURE
}

model Association {
  id                String   @id @default(cuid())
  name              String   @db.VarChar(150)
  legalName         String?  @db.VarChar(255)
  logoUrl           String?  @db.VarChar(500)
  primaryColor      String?  @db.VarChar(20)
  secondaryColor    String?  @db.VarChar(20)
  legalNotice       String?
  billingName       String?  @db.VarChar(255)
  billingAddress    String?  @db.VarChar(255)
  billingPostalCode String?  @db.VarChar(20)
  billingCity       String?  @db.VarChar(120)
  billingCountry    String?  @db.VarChar(100)
  billingEmail      String?  @db.VarChar(255)
  billingPhone      String?  @db.VarChar(30)
  siret             String?  @db.VarChar(30)
  pdfFooter         String?
  timezone          String   @default("Europe/Paris") @db.VarChar(100)
  locale            String   @default("fr-FR") @db.VarChar(20)
  currency          String   @default("EUR") @db.VarChar(3)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  roles            Role[]
  users            User[]
  clients          Client[]
  projects         Project[]
  intervenors      Intervenor[]
  auditLogs        AuditLog[]
  billingDocuments BillingDocument[]
  billingSequences BillingSequence[]
}

model Role {
  id            String   @id @default(cuid())
  associationId String
  name          String   @db.VarChar(100)
  code          String   @db.VarChar(50)
  description   String?
  permissions   String[] @default([])
  isSystemRole  Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  association Association @relation(fields: [associationId], references: [id], onDelete: Cascade)
  users       User[]

  @@unique([associationId, code])
  @@unique([associationId, name])
}

model User {
  id                   String     @id @default(cuid())
  associationId        String
  roleId               String
  clientId             String?
  firstName            String     @db.VarChar(100)
  lastName             String     @db.VarChar(100)
  email                String     @unique @db.VarChar(255)
  passwordHash         String
  phone                String?    @db.VarChar(30)
  status               UserStatus @default(ACTIVE)
  accessExpiresAt      DateTime?
  lastLoginAt          DateTime?
  passwordChangedAt    DateTime   @default(now())
  resetToken           String?    @unique @db.VarChar(255)
  resetTokenExpiresAt  DateTime?
  mfaEnabled           Boolean    @default(false)
  mfaSecretCiphertext  String?
  mfaSecretIv          String?
  mfaSecretTag         String?
  mfaRecoveryCodesHash String[]   @default([])
  mfaConfirmedAt       DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  association Association @relation(fields: [associationId], references: [id], onDelete: Cascade)
  role        Role        @relation(fields: [roleId], references: [id])
  client      Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)

  intervenorProfile           Intervenor?
  sessions                    AuthSession[]
  passwordResetTokens         PasswordResetToken[]
  notifications               Notification[]
  auditLogs                   AuditLog[]
  uploadedProjectDocuments    ProjectDocument[]              @relation("ProjectDocumentUploadedBy")
  reviewedIntervenorDocuments IntervenorDocument[]           @relation("IntervenorDocumentReviewedBy")
  reviewedAccountingDocuments IntervenorAccountingDocument[] @relation("AccountingDocumentReviewedBy")
  reviewedProjectReports      ProjectReport[]                @relation("ProjectReportReviewedBy")
  reportVersions              ProjectReportVersion[]         @relation("ProjectReportVersionCreatedBy")
  createdBillingDocuments     BillingDocument[]              @relation("BillingDocumentCreatedBy")

  @@index([associationId])
  @@index([roleId])
  @@index([clientId])
  @@index([status])
  @@index([accessExpiresAt])
}

model AuthSession {
  id            String    @id @default(cuid())
  userId        String
  tokenHash     String    @unique @db.VarChar(64)
  expiresAt     DateTime
  mfaVerifiedAt DateTime?
  ipHash        String?   @db.VarChar(64)
  userAgent     String?   @db.VarChar(500)
  lastSeenAt    DateTime  @default(now())
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String   @db.VarChar(255)
  ipHash    String?  @db.VarChar(64)
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipHash, createdAt])
}

model AuditLog {
  id            String       @id @default(cuid())
  associationId String
  userId        String?
  action        String       @db.VarChar(100)
  outcome       AuditOutcome @default(SUCCESS)
  entityType    String?      @db.VarChar(100)
  entityId      String?      @db.VarChar(191)
  requestId     String?      @db.VarChar(100)
  ipHash        String?      @db.VarChar(64)
  userAgent     String?      @db.VarChar(500)
  metadata      Json?
  createdAt     DateTime     @default(now())

  association Association @relation(fields: [associationId], references: [id], onDelete: Cascade)
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([associationId, createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([action])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(INFO)
  title     String           @db.VarChar(180)
  message   String
  href      String?          @db.VarChar(500)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model Client {
  id                  String       @id @default(cuid())
  associationId       String
  type                ClientType
  status              ClientStatus @default(ACTIVE)
  name                String       @db.VarChar(150)
  serviceName         String?      @db.VarChar(150)
  email               String?      @db.VarChar(255)
  phone1              String?      @db.VarChar(30)
  phone2              String?      @db.VarChar(30)
  siret               String?      @db.VarChar(30)
  addressLine1        String       @db.VarChar(255)
  addressLine2        String?      @db.VarChar(255)
  postalCode          String       @db.VarChar(20)
  city                String       @db.VarChar(120)
  country             String       @db.VarChar(100)
  billingAddressLine1 String?      @db.VarChar(255)
  billingAddressLine2 String?      @db.VarChar(255)
  billingPostalCode   String?      @db.VarChar(20)
  billingCity         String?      @db.VarChar(120)
  billingCountry      String?      @db.VarChar(100)
  notes               String?
  archivedAt          DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  association      Association       @relation(fields: [associationId], references: [id], onDelete: Cascade)
  contacts         ClientContact[]
  projectClients   ProjectClient[]
  users            User[]
  billingDocuments BillingDocument[]

  @@index([associationId])
  @@index([associationId, status])
  @@index([archivedAt])
  @@index([siret])
}

model ClientContact {
  id        String   @id @default(cuid())
  clientId  String
  firstName String   @db.VarChar(100)
  lastName  String   @db.VarChar(100)
  jobTitle  String?  @db.VarChar(100)
  email     String?  @db.VarChar(255)
  phone1    String?  @db.VarChar(30)
  phone2    String?  @db.VarChar(30)
  isPrimary Boolean  @default(false)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model Project {
  id                  String        @id @default(cuid())
  associationId       String
  reference           String?       @db.VarChar(50)
  title               String        @db.VarChar(255)
  description         String?
  status              ProjectStatus @default(DRAFT)
  internalComments    String?
  startDate           DateTime?
  endDate             DateTime?
  plannedBudget       Decimal?      @db.Decimal(12, 2)
  actualBudget        Decimal?      @db.Decimal(12, 2)
  totalIntervenorCost Decimal?      @db.Decimal(12, 2)
  materialCost        Decimal?      @db.Decimal(12, 2)
  printingCost        Decimal?      @db.Decimal(12, 2)
  otherCost           Decimal?      @db.Decimal(12, 2)
  estimatedNetMargin  Decimal?      @db.Decimal(12, 2)
  actualNetMargin     Decimal?      @db.Decimal(12, 2)
  totalSessions       Int?
  sessionUnitPrice    Decimal?      @db.Decimal(12, 2)
  archivedAt          DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  association         Association                    @relation(fields: [associationId], references: [id], onDelete: Cascade)
  projectClients      ProjectClient[]
  projectIntervenors  ProjectIntervenor[]
  documents           ProjectDocument[]
  reports             ProjectReport[]
  accountingDocuments IntervenorAccountingDocument[]
  billingDocuments    BillingDocument[]

  @@unique([associationId, reference])
  @@index([associationId])
  @@index([associationId, status])
  @@index([archivedAt])
}

model ProjectClient {
  id           String   @id @default(cuid())
  projectId    String
  clientId     String
  isMainClient Boolean  @default(false)
  createdAt    DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([projectId, clientId])
  @@index([clientId])
}

model Intervenor {
  id            String           @id @default(cuid())
  associationId String
  userId        String?          @unique
  firstName     String           @db.VarChar(100)
  lastName      String           @db.VarChar(100)
  email         String           @db.VarChar(255)
  phone         String?          @db.VarChar(30)
  specialty     String?          @db.VarChar(150)
  status        IntervenorStatus @default(ACTIVE)
  siret         String?          @db.VarChar(30)
  ribIban       String?          @db.VarChar(34)
  ribBic        String?          @db.VarChar(11)
  addressLine1  String?          @db.VarChar(255)
  addressLine2  String?          @db.VarChar(255)
  postalCode    String?          @db.VarChar(20)
  city          String?          @db.VarChar(120)
  country       String?          @db.VarChar(100)
  notes         String?
  archivedAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  association         Association                    @relation(fields: [associationId], references: [id], onDelete: Cascade)
  user                User?                          @relation(fields: [userId], references: [id], onDelete: SetNull)
  projectLinks        ProjectIntervenor[]
  documents           IntervenorDocument[]
  accountingDocuments IntervenorAccountingDocument[]
  reports             ProjectReport[]

  @@unique([associationId, email])
  @@index([associationId])
  @@index([associationId, status])
  @@index([archivedAt])
}

model ProjectIntervenor {
  id               String           @id @default(cuid())
  projectId        String
  intervenorId     String
  assignmentStatus AssignmentStatus @default(PENDING)
  invitedAt        DateTime?
  respondedAt      DateTime?
  responseComment  String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  intervenor Intervenor @relation(fields: [intervenorId], references: [id], onDelete: Cascade)

  @@unique([projectId, intervenorId])
  @@index([intervenorId])
  @@index([assignmentStatus])
}

model ProjectDocument {
  id               String              @id @default(cuid())
  projectId        String
  uploadedByUserId String?
  type             ProjectDocumentType @default(OTHER)
  visibility       DocumentVisibility  @default(ADMIN_ONLY)
  title            String?             @db.VarChar(255)
  originalName     String              @db.VarChar(255)
  storedName       String              @db.VarChar(255)
  filePath         String              @db.VarChar(500)
  mimeType         String              @db.VarChar(100)
  fileSize         BigInt
  sha256           String?             @db.VarChar(64)
  version          Int                 @default(1)
  archivedAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  project        Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedByUser User?   @relation("ProjectDocumentUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([projectId, visibility])
  @@index([type])
  @@index([visibility])
  @@index([archivedAt])
  @@index([sha256])
}

model IntervenorDocument {
  id               String                   @id @default(cuid())
  intervenorId     String
  reviewedByUserId String?
  type             IntervenorDocumentType
  status           IntervenorDocumentStatus @default(PENDING)
  title            String?                  @db.VarChar(255)
  originalName     String                   @db.VarChar(255)
  storedName       String                   @db.VarChar(255)
  filePath         String                   @db.VarChar(500)
  mimeType         String                   @db.VarChar(100)
  fileSize         BigInt
  sha256           String?                  @db.VarChar(64)
  version          Int                      @default(1)
  adminComment     String?
  archivedAt       DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  reviewedAt       DateTime?

  intervenor     Intervenor @relation(fields: [intervenorId], references: [id], onDelete: Cascade)
  reviewedByUser User?      @relation("IntervenorDocumentReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([intervenorId])
  @@index([status])
  @@index([reviewedByUserId])
  @@index([archivedAt])
  @@index([sha256])
}

model IntervenorAccountingDocument {
  id               String                   @id @default(cuid())
  intervenorId     String
  projectId        String?
  reviewedByUserId String?
  type             AccountingDocumentType
  status           AccountingDocumentStatus @default(PENDING)
  title            String?                  @db.VarChar(255)
  description      String?
  periodMonth      Int?
  periodYear       Int?
  originalName     String                   @db.VarChar(255)
  storedName       String                   @db.VarChar(255)
  filePath         String                   @db.VarChar(500)
  mimeType         String                   @db.VarChar(100)
  fileSize         BigInt
  sha256           String?                  @db.VarChar(64)
  version          Int                      @default(1)
  adminComment     String?
  archivedAt       DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  reviewedAt       DateTime?

  intervenor     Intervenor @relation(fields: [intervenorId], references: [id], onDelete: Cascade)
  project        Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  reviewedByUser User?      @relation("AccountingDocumentReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([intervenorId])
  @@index([projectId])
  @@index([status])
  @@index([type])
  @@index([periodYear, periodMonth])
  @@index([reviewedByUserId])
  @@index([archivedAt])
  @@index([sha256])
}

model ProjectReport {
  id               String       @id @default(cuid())
  projectId        String
  intervenorId     String?
  reviewedByUserId String?
  title            String?      @db.VarChar(255)
  sessionDate      DateTime
  studentsCount    Int?
  status           ReportStatus @default(NOT_STARTED)
  currentVersion   Int          @default(0)
  pdfPath          String?      @db.VarChar(500)
  comment          String?
  refusalReason    String?
  submittedAt      DateTime?
  validatedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  reviewedAt       DateTime?

  project        Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  intervenor     Intervenor?            @relation(fields: [intervenorId], references: [id], onDelete: SetNull)
  reviewedByUser User?                  @relation("ProjectReportReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  versions       ProjectReportVersion[]

  @@unique([projectId, intervenorId, sessionDate])
  @@index([projectId])
  @@index([intervenorId])
  @@index([status])
  @@index([reviewedByUserId])
}

model ProjectReportVersion {
  id              String   @id @default(cuid())
  reportId        String
  createdByUserId String?
  version         Int
  content         String
  createdAt       DateTime @default(now())

  report        ProjectReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  createdByUser User?         @relation("ProjectReportVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([reportId, version])
  @@index([createdByUserId])
}

model BillingDocument {
  id              String                @id @default(cuid())
  associationId   String
  clientId        String
  projectId       String?
  createdByUserId String?
  sourceQuoteId   String?
  kind            BillingDocumentKind
  number          String                @db.VarChar(60)
  status          BillingDocumentStatus @default(DRAFT)
  issueDate       DateTime              @default(now())
  dueDate         DateTime?
  currency        String                @default("EUR") @db.VarChar(3)
  subject         String?               @db.VarChar(255)
  notes           String?
  subtotal        Decimal               @default(0) @db.Decimal(12, 2)
  taxRate         Decimal               @default(0) @db.Decimal(5, 2)
  taxAmount       Decimal               @default(0) @db.Decimal(12, 2)
  total           Decimal               @default(0) @db.Decimal(12, 2)
  sentAt          DateTime?
  acceptedAt      DateTime?
  paidAt          DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  association       Association       @relation(fields: [associationId], references: [id], onDelete: Cascade)
  client            Client            @relation(fields: [clientId], references: [id])
  project           Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdByUser     User?             @relation("BillingDocumentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  sourceQuote       BillingDocument?  @relation("QuoteConversion", fields: [sourceQuoteId], references: [id], onDelete: SetNull)
  convertedInvoices BillingDocument[] @relation("QuoteConversion")
  lines             BillingLine[]

  @@unique([associationId, number])
  @@index([associationId, kind, status])
  @@index([clientId])
  @@index([projectId])
  @@index([sourceQuoteId])
}

model BillingLine {
  id                String   @id @default(cuid())
  billingDocumentId String
  position          Int
  description       String
  quantity          Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice         Decimal  @db.Decimal(12, 2)
  lineTotal         Decimal  @db.Decimal(12, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  billingDocument BillingDocument @relation(fields: [billingDocumentId], references: [id], onDelete: Cascade)

  @@unique([billingDocumentId, position])
  @@index([billingDocumentId])
}

model BillingSequence {
  id            String              @id @default(cuid())
  associationId String
  kind          BillingDocumentKind
  year          Int
  lastNumber    Int                 @default(0)
  updatedAt     DateTime            @updatedAt

  association Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  @@unique([associationId, kind, year])
}

// -----------------------------------------------------------------------------
// Extended IFICS modules: support, CMS, CRM, R&D, IT, HR and public publication.
// Auxiliary modules use association-scoped scalar references at module boundaries;
// the service layer validates ownership before every cross-module write.
// -----------------------------------------------------------------------------

enum TicketStatus {
  NEW
  IN_PROGRESS
  WAITING_REQUESTER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketCategory {
  ADMIN
  BILLING
  CONTRACT
  PROJECT
  PLATFORM
  DOCUMENT
  IT
  HR
  SECURITY
  OTHER
}

enum ContentKind {
  PAGE
  ARTICLE
  NEWS
  RND
  ACTIVITY_REPORT
}

enum ContentStatus {
  DRAFT
  REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum PartnerType {
  INSTITUTIONAL
  COLLECTIVITY
  COMPANY
  PATRON
  OPERATIONAL
  TECHNICAL
}

enum PartnerPipelineStage {
  IDENTIFIED
  CONTACTED
  MEETING
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum ProposalStatus {
  NEW
  QUALIFYING
  CONTACTED
  STUDY
  NEGOTIATION
  ACCEPTED
  REJECTED
  CONVERTED
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum ApplicationStatus {
  NEW
  REVIEW
  INTERVIEW
  ACCEPTED
  REJECTED
  ARCHIVED
}

enum SoftwareStatus {
  EXPERIMENTAL
  BETA
  STABLE
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum AssetStatus {
  STOCK
  ASSIGNED
  MAINTENANCE
  RETIRED
  LOST
}

enum RndStatus {
  IDEA
  EXPLORATION
  PROTOTYPE
  PILOT
  ACTIVE
  ARCHIVED
}

enum HrEmploymentType {
  EMPLOYEE
  VOLUNTEER
  INTERN
  APPRENTICE
  EXTERNAL
}

enum ContactRequestStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  ARCHIVED
}

model SupportTicket {
  id              String          @id @default(cuid())
  associationId   String
  number          String          @db.VarChar(40)
  requesterUserId String?
  requesterEmail  String?         @db.VarChar(255)
  projectId       String?
  category        TicketCategory  @default(OTHER)
  priority        TicketPriority  @default(NORMAL)
  status          TicketStatus    @default(NEW)
  subject         String          @db.VarChar(255)
  description     String
  assigneeUserId  String?
  resolvedAt      DateTime?
  closedAt        DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  comments        TicketComment[]

  @@unique([associationId, number])
  @@index([associationId, status, priority])
  @@index([requesterUserId])
  @@index([assigneeUserId])
  @@index([projectId])
}

model TicketComment {
  id           String        @id @default(cuid())
  ticketId     String
  authorUserId String?
  body         String
  internal     Boolean       @default(false)
  attachments  Json?
  createdAt    DateTime      @default(now())
  ticket       SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

model TicketSequence {
  id            String   @id @default(cuid())
  associationId String
  year          Int
  lastNumber    Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@unique([associationId, year])
}

model CmsEntry {
  id               String        @id @default(cuid())
  associationId    String
  kind             ContentKind
  slug             String        @db.VarChar(180)
  titleFr          String        @db.VarChar(255)
  titleEn          String?       @db.VarChar(255)
  excerptFr        String?
  excerptEn        String?
  bodyFr           String
  bodyEn           String?
  heroImageUrl     String?       @db.VarChar(500)
  gallery          Json?
  status           ContentStatus @default(DRAFT)
  featured         Boolean       @default(false)
  authorUserId     String?
  reviewedByUserId String?
  scheduledAt      DateTime?
  publishedAt      DateTime?
  archivedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([associationId, kind, slug])
  @@index([associationId, kind, status])
  @@index([publishedAt])
}

model Partner {
  id            String               @id @default(cuid())
  associationId String
  name          String               @db.VarChar(200)
  type          PartnerType
  stage         PartnerPipelineStage @default(IDENTIFIED)
  website       String?              @db.VarChar(500)
  logoUrl       String?              @db.VarChar(500)
  descriptionFr String?
  descriptionEn String?
  publicEnabled Boolean              @default(false)
  notes         String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  contacts      PartnerContact[]
  interactions  PartnerInteraction[]
  messages      PartnerMessage[]

  @@index([associationId, type])
  @@index([associationId, stage])
}

model PartnerContact {
  id        String   @id @default(cuid())
  partnerId String
  firstName String   @db.VarChar(100)
  lastName  String   @db.VarChar(100)
  jobTitle  String?  @db.VarChar(150)
  email     String?  @db.VarChar(255)
  phone     String?  @db.VarChar(30)
  isPrimary Boolean  @default(false)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
}

model PartnerInteraction {
  id           String    @id @default(cuid())
  partnerId    String
  authorUserId String?
  occurredAt   DateTime  @default(now())
  kind         String    @db.VarChar(80)
  summary      String
  nextAction   String?
  nextActionAt DateTime?
  createdAt    DateTime  @default(now())
  partner      Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId, occurredAt])
  @@index([nextActionAt])
}

model PartnerMessage {
  id           String   @id @default(cuid())
  partnerId    String
  authorUserId String?
  body         String
  internal     Boolean  @default(false)
  createdAt    DateTime @default(now())
  partner      Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId, createdAt])
}

model ProjectPublication {
  id            String    @id @default(cuid())
  associationId String
  projectId     String    @unique
  slug          String    @db.VarChar(180)
  titleFr       String    @db.VarChar(255)
  titleEn       String?   @db.VarChar(255)
  summaryFr     String
  summaryEn     String?
  imageUrl      String?   @db.VarChar(500)
  territory     String?   @db.VarChar(150)
  publicStatus  String?   @db.VarChar(80)
  publicEnabled Boolean   @default(false)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([associationId, slug])
  @@index([associationId, publicEnabled])
}

model IntervenorPublicProfile {
  id               String    @id @default(cuid())
  associationId    String
  intervenorId     String    @unique
  displayName      String?   @db.VarChar(200)
  bioFr            String?
  bioEn            String?
  photoUrl         String?   @db.VarChar(500)
  skills           String[]  @default([])
  languages        String[]  @default([])
  certifications   String[]  @default([])
  links            Json?
  publicEnabled    Boolean   @default(false)
  approvedAt       DateTime?
  approvedByUserId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([associationId, publicEnabled])
}

model ProjectProposal {
  id                 String         @id @default(cuid())
  associationId      String
  organizationName   String         @db.VarChar(200)
  contactName        String         @db.VarChar(200)
  email              String         @db.VarChar(255)
  phone              String?        @db.VarChar(30)
  territory          String?        @db.VarChar(150)
  audience           String?
  issue              String
  proposalType       String?        @db.VarChar(150)
  timeframe          String?        @db.VarChar(150)
  budget             Decimal?       @db.Decimal(12, 2)
  participantCount   Int?
  comment            String?
  attachmentPath     String?        @db.VarChar(500)
  status             ProposalStatus @default(NEW)
  assignedUserId     String?
  convertedProjectId String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([associationId, status])
  @@index([email])
}

model ContactRequest {
  id             String               @id @default(cuid())
  associationId  String
  reason         String               @db.VarChar(100)
  name           String               @db.VarChar(200)
  organization   String?              @db.VarChar(200)
  email          String               @db.VarChar(255)
  phone          String?              @db.VarChar(30)
  message        String
  status         ContactRequestStatus @default(NEW)
  assignedUserId String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([associationId, status])
}

model JobOpening {
  id            String           @id @default(cuid())
  associationId String
  slug          String           @db.VarChar(180)
  title         String           @db.VarChar(255)
  contractType  String?          @db.VarChar(100)
  location      String?          @db.VarChar(150)
  descriptionFr String
  descriptionEn String?
  status        JobStatus        @default(DRAFT)
  publishedAt   DateTime?
  closedAt      DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  applications  JobApplication[]

  @@unique([associationId, slug])
  @@index([associationId, status])
}

model JobApplication {
  id        String            @id @default(cuid())
  openingId String
  name      String            @db.VarChar(200)
  email     String            @db.VarChar(255)
  phone     String?           @db.VarChar(30)
  message   String?
  cvPath    String?           @db.VarChar(500)
  status    ApplicationStatus @default(NEW)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  opening   JobOpening        @relation(fields: [openingId], references: [id], onDelete: Cascade)

  @@index([openingId, status])
}

model SoftwareCategory {
  id            String         @id @default(cuid())
  associationId String
  name          String         @db.VarChar(120)
  slug          String         @db.VarChar(120)
  createdAt     DateTime       @default(now())
  items         SoftwareItem[]

  @@unique([associationId, slug])
}

model SoftwareItem {
  id            String            @id @default(cuid())
  associationId String
  categoryId    String?
  name          String            @db.VarChar(200)
  slug          String            @db.VarChar(180)
  descriptionFr String
  descriptionEn String?
  audience      String?
  features      Json?
  platforms     String[]          @default([])
  license       String?           @db.VarChar(120)
  openSource    Boolean           @default(false)
  repoUrl       String?           @db.VarChar(500)
  docsUrl       String?           @db.VarChar(500)
  videoUrl      String?           @db.VarChar(500)
  status        SoftwareStatus    @default(EXPERIMENTAL)
  publicEnabled Boolean           @default(false)
  downloadCount Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  category      SoftwareCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  versions      SoftwareVersion[]

  @@unique([associationId, slug])
  @@index([associationId, status, publicEnabled])
}

model SoftwareVersion {
  id          String         @id @default(cuid())
  softwareId  String
  version     String         @db.VarChar(50)
  changelog   String?
  filePath    String?        @db.VarChar(500)
  sha256      String?        @db.VarChar(64)
  fileSize    BigInt?
  status      SoftwareStatus @default(EXPERIMENTAL)
  publishedAt DateTime?
  createdAt   DateTime       @default(now())
  software    SoftwareItem   @relation(fields: [softwareId], references: [id], onDelete: Cascade)

  @@unique([softwareId, version])
  @@index([softwareId, publishedAt])
}

model RndProject {
  id               String    @id @default(cuid())
  associationId    String
  title            String    @db.VarChar(255)
  description      String?
  ownerUserId      String?
  status           RndStatus @default(IDEA)
  budget           Decimal?  @db.Decimal(12, 2)
  repoUrl          String?   @db.VarChar(500)
  documentationUrl String?   @db.VarChar(500)
  testResults      String?
  publicEnabled    Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([associationId, status])
}

model WorkTask {
  id              String       @id @default(cuid())
  associationId   String
  projectId       String?
  title           String       @db.VarChar(255)
  description     String?
  status          TaskStatus   @default(TODO)
  priority        TaskPriority @default(NORMAL)
  assigneeUserId  String?
  dueDate         DateTime?
  createdByUserId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([associationId, status, priority])
  @@index([projectId])
  @@index([assigneeUserId])
}

model Department {
  id            String                 @id @default(cuid())
  associationId String
  name          String                 @db.VarChar(150)
  code          String                 @db.VarChar(50)
  description   String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  memberships   DepartmentMembership[]

  @@unique([associationId, code])
}

model DepartmentMembership {
  id           String     @id @default(cuid())
  departmentId String
  userId       String
  position     String?    @db.VarChar(150)
  isManager    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([departmentId, userId])
  @@index([userId])
}

model HrProfile {
  id             String           @id @default(cuid())
  associationId  String
  userId         String           @unique
  employmentType HrEmploymentType
  startDate      DateTime?
  endDate        DateTime?
  managerUserId  String?
  skills         String[]         @default([])
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  absences       HrAbsence[]
  trainings      HrTraining[]
  reviews        HrReview[]

  @@index([associationId, employmentType])
}

model HrAbsence {
  id        String    @id @default(cuid())
  profileId String
  type      String    @db.VarChar(100)
  startDate DateTime
  endDate   DateTime
  status    String    @default("PENDING") @db.VarChar(40)
  note      String?
  createdAt DateTime  @default(now())
  profile   HrProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, startDate])
}

model HrTraining {
  id              String    @id @default(cuid())
  profileId       String
  title           String    @db.VarChar(255)
  provider        String?   @db.VarChar(200)
  completedAt     DateTime?
  expiresAt       DateTime?
  certificatePath String?   @db.VarChar(500)
  createdAt       DateTime  @default(now())
  profile         HrProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, expiresAt])
}

model HrReview {
  id             String    @id @default(cuid())
  profileId      String
  reviewerUserId String?
  reviewDate     DateTime
  summary        String
  objectives     String?
  createdAt      DateTime  @default(now())
  profile        HrProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, reviewDate])
}

model Asset {
  id             String      @id @default(cuid())
  associationId  String
  inventoryTag   String      @db.VarChar(100)
  type           String      @db.VarChar(100)
  brand          String?     @db.VarChar(100)
  model          String?     @db.VarChar(150)
  serialNumber   String?     @db.VarChar(150)
  status         AssetStatus @default(STOCK)
  assignedUserId String?
  location       String?     @db.VarChar(200)
  purchaseDate   DateTime?
  warrantyUntil  DateTime?
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([associationId, inventoryTag])
  @@index([associationId, status])
  @@index([assignedUserId])
}

model SystemSetting {
  id            String   @id @default(cuid())
  associationId String
  key           String   @db.VarChar(120)
  value         Json
  updatedAt     DateTime @updatedAt

  @@unique([associationId, key])
}
